      "Bash(netstat -ano)",
      "Bash(git ls-remote:*)",
      "Bash(gh auth:*)",
      "Bash(du -sh */)",
      "Bash(git check-ignore:*)",
      "Bash(echo \"--- exit: $?---\")",
      "Bash(find . -name .env* -not -path ./node_modules/*)",
      "Bash(find . -type f -not -path */node_modules/* -not -path */.next/* -size +10M)",
