# Copy to .env.local. Only NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_USE_MOCK=true

# Server-only. Name of the httpOnly session cookie issued by the backend.
# Used by middleware for an optimistic redirect on protected routes (the backend still enforces auth).
# Leave empty if the cookie is not visible to this origin; client-side guards still apply.
SESSION_COOKIE_NAME=xh_session
