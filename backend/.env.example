# Copy to .env (never commit .env). Docker Compose reads it automatically.

APP_ENV=development            # development | staging | production
PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error

# ---------------- database (see docs/db/OPERATIONS.md) ----------------
# Compose: the superuser is only used by the one-shot bootstrap; the API runs as redxtube_app
# (least privilege), migrations as redxtube_migrator. Use long random passwords.
DB_NAME=redxtube
POSTGRES_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app
MIGRATOR_DB_PASSWORD=change-me-migrator
REDIS_PASSWORD=change-me-redis
# Running the API outside Docker (go run ./cmd/api): the API connects as redxtube_app, never as a superuser.
DATABASE_URL=postgres://redxtube_app:change-me-app@localhost:5432/redxtube?sslmode=disable
REDIS_URL=redis://:change-me-redis@localhost:6379/0
DB_MAX_CONNS=10

# Exact origins of the frontend (no wildcard, cookies are used). https only in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public base URL for thumbnails/avatars/HLS (CDN or object storage). Empty = image URLs are null.
CDN_URL=

# ---------------- accounts, sessions, email ----------------
# Frontend base URL: used in reset-password links and to decide Secure cookies (https => Secure).
APP_URL=http://localhost:3000
# Share cookies between redxtube.com and api.redxtube.com. Leave empty for localhost.
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=xh_session
# Master secret (>= 32 chars) for signing age cookies and keying OTP/IP hashes. REQUIRED in production:
#   openssl rand -base64 48
# If empty in development a random one is generated at startup (age cookies reset on restart).
AUTH_SECRET=
# Trust CF-Connecting-IP / X-Forwarded-For for client IPs. Only true behind your own proxy/CDN.
TRUST_PROXY_HEADERS=false
# resend (production) | log (dev: prints codes to the log) | none (drop mail)
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=REDXTUBE <no-reply@redxtube.com>

# ---------------- uploads (S3-compatible storage) ----------------
# Leave STORAGE_ENDPOINT empty to disable uploads. Setting it requires ALL of: access key, secret, bucket.
# The browser uploads parts straight to storage, so the bucket's CORS must allow your web origin
# (methods PUT, GET, HEAD; expose the ETag header). Keep the bucket private: uploads/ is never public.
# Local MinIO:  docker compose --profile storage up --build
#   STORAGE_ENDPOINT=http://minio:9000   STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ENDPOINT=
# What the BROWSER can reach (presigned URLs point here). Defaults to STORAGE_ENDPOINT.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=redxtube
# true for MinIO/self-hosted, false for AWS S3 virtual-hosted style (default: true unless *.amazonaws.com)
STORAGE_PATH_STYLE=

# --- added in later phases ---
# B7 playback: PLAYBACK_SIGNING_KEY=
