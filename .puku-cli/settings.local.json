{
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker run:*)",
      "Bash(docker image:*)",
      "Bash(docker volume:*)",
      "Bash(curl:*)",
      "Bash(docker exec:*)",
      "Bash(grep -rn 'mux.HandleFunc' /f/redxtube-updated/backend/internal/handler/*.go)",
      "Bash(grep -rn 'const v = ' /f/redxtube-updated/backend/internal/handler/*.go)",
      "Bash(npm run:*)",
